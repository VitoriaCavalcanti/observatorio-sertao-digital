<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Observatório Sertão Digital{% endblock %}</title>
    {% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/app.css') }}">{% endblock %}
</head>
<body>
<header class="topbar">
    <a class="brand" href="{{ path('admin_dashboard') }}">Observatório <strong>Sertão Digital</strong></a>
    {% if app.user %}
        <nav><a href="{{ path('admin_dashboard') }}">Painel</a><a href="{{ path('admin_post_index') }}">Avisos</a><a href="{{ path('admin_data_index', {tipo: 'instituicoes'}) }}">Instituições</a><a href="{{ path('admin_data_index', {tipo: 'projetos'}) }}">Projetos</a><a href="{{ path('admin_data_index', {tipo: 'indicadores'}) }}">Indicadores</a>{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_user_index') }}">Usuários</a>{% endif %}</nav>
        <div class="user">{{ app.user.nome }}<form action="{{ path('security_logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button>Sair</button></form></div>
    {% endif %}
</header>
<main class="container">
    {% for type, messages in app.flashes %}{% for message in messages %}<div class="alert {{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
