{% extends 'base.html.twig' %}{% block title %}Avisos{% endblock %}{% block main %}<h1>Avisos do Observatório</h1>{% for post in posts %}<article class="post"><h2><a href="{{ path('aviso_show',{slug:post.slug}) }}">{{ post.titulo }}</a></h2><p class="post-metadata"><twig:ux:icon name="tabler:calendar-month"/> {{ post.publicadoEm|date('d/m/Y H:i') }} · {{ post.autor.nome }}</p><p>{{ post.resumo }}</p></article>{% else %}<div class="alert alert-info">Nenhum aviso público foi publicado.</div>{% endfor %}{% endblock %}
