{% extends 'admin/layout.html.twig' %}{% block title %}Usuários{% endblock %}{% block body %}<div class="page-head"><div><p class="eyebrow">SEGURANÇA</p><h1>Usuários</h1></div><a class="btn btn-primary" href="{{ path('admin_user_new') }}">Novo usuário</a></div><div class="panel"><table class="table table-striped"><thead><tr><th>Nome</th><th>E-mail</th><th>Papéis</th><th></th></tr></thead><tbody>{% for usuario in usuarios %}<tr><td>{{ usuario.nome }}</td><td>{{ usuario.email }}</td><td>{{ usuario.roles|join(', ') }}</td><td><a class="btn btn-sm btn-secondary" href="{{ path('admin_user_edit',{id:usuario.id}) }}">Editar</a></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
