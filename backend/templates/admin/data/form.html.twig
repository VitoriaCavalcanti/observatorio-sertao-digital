{% extends 'base.html.twig' %}
{% block title %}{{ item.id ? 'Editar' : 'Novo' }} registro{% endblock %}
{% block body %}<div class="page-head"><div><p class="eyebrow">{{ tipo|upper }}</p><h1>{{ item.id ? 'Editar registro' : 'Novo registro' }}</h1></div></div><div class="panel form-panel">{{ form_start(form) }}{{ form_widget(form) }}<div class="form-actions"><button class="primary">Salvar</button><a href="{{ path('admin_data_index', {tipo:tipo}) }}">Cancelar</a></div>{{ form_end(form) }}{% if item.id and is_granted('ROLE_ADMIN') %}<form action="{{ path('admin_data_delete', {tipo:tipo,id:item.id}) }}" method="post" onsubmit="return confirm('Excluir este registro?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-'~tipo~'-'~item.id) }}"><button>Excluir registro</button></form>{% endif %}</div>{% endblock %}
