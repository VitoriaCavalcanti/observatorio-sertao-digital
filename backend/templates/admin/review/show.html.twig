{% extends 'admin/layout.html.twig' %}
{% block title %}Revisar {{ nome }}{% endblock %}
{% block body %}
<div class="page-head"><div><p class="eyebrow">REVISÃO DE {{ tipo|upper }}</p><h1>{{ nome }}</h1><p>Responsável: {{ item.responsavel ? item.responsavel.nome ~ ' — ' ~ item.responsavel.email : 'Equipe interna' }}</p></div><a href="{{ path('admin_review_index') }}">Voltar</a></div>
<div class="row g-4"><div class="col-lg-6"><div class="panel form-panel"><h2>Versão publicada/atual</h2><dl>{% for campo,valor in atual %}<dt>{{ campo }}</dt><dd>{{ valor is null ? '—' : valor }}</dd>{% endfor %}</dl></div></div><div class="col-lg-6"><div class="panel form-panel"><h2>Proposta do usuário</h2><dl>{% for campo,valor in proposta %}<dt>{{ campo }}</dt><dd>{{ valor is null ? '—' : valor }}</dd>{% endfor %}</dl></div></div></div>
<div class="panel form-panel mt-4"><h2>Decisão</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('review-'~tipo~'-'~item.id) }}"><label for="observacao">Observação ao usuário</label><textarea class="form-control" id="observacao" name="observacao" rows="4" placeholder="Obrigatória ao devolver para correção"></textarea><div class="form-actions mt-3"><button class="btn btn-success" formaction="{{ path('admin_review_action',{tipo:tipo,id:item.id,acao:'aprovar'}) }}">Aprovar e publicar</button><button class="btn btn-warning" formaction="{{ path('admin_review_action',{tipo:tipo,id:item.id,acao:'devolver'}) }}">Devolver</button><button class="btn btn-danger" formaction="{{ path('admin_review_action',{tipo:tipo,id:item.id,acao:'rejeitar'}) }}">Rejeitar</button></div></form></div>
<div class="panel table-wrap mt-4"><h2>Histórico</h2><table><thead><tr><th>Data</th><th>Ação</th><th>Responsável</th><th>Revisor</th><th>Observação</th></tr></thead><tbody>{% for evento in historico %}<tr><td>{{ evento.criadoEm|date('d/m/Y H:i') }}</td><td>{{ evento.acao|capitalize }}</td><td>{{ evento.responsavel ? evento.responsavel.nome : '—' }}</td><td>{{ evento.revisor ? evento.revisor.nome : '—' }}</td><td>{{ evento.observacao ?: '—' }}</td></tr>{% else %}<tr><td colspan="5">Sem eventos anteriores.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
